# Copie este arquivo para ".env" (só no seu computador) ou cadastre as variáveis no painel do Render.

# Endereço do banco PostgreSQL (Neon, Supabase, Render...).
# Deixe vazio no seu computador para usar o banco embutido (pasta ./dados).
DATABASE_URL=

# Segredo para assinar os logins. Use um texto longo e aleatório e NUNCA divulgue.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta (o Render define sozinho; não precisa mexer)
PORT=3000

# Criar restaurantes/cliente de demonstração quando o banco estiver vazio (true/false)
SEED=true

# Só se o frontend for hospedado em OUTRO domínio (ex.: https://meusite.netlify.app). Separe por vírgula.
CORS_ORIGINS=

# Opcionais
# JWT_VALIDADE=7d          # tempo até precisar entrar de novo
# LIMITE_LOGIN=30          # tentativas de login/cadastro por IP a cada 15 min
# LIMITE_API=300           # requisições por IP por minuto
# DB_SSL=false             # desliga SSL (só para Postgres local sem SSL)
